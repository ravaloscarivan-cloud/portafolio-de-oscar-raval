<section class="prh-categories">
  <div class="prh-categories__intro"><p>PRH STORE</p><h1>Categorías</h1><span>Explora nuestras categorías y encuentra lo que buscas.</span></div>
  <div class="prh-categories__grid">
    {% assign category_handles = 'computadores,ropa-y-moda,deporte,herramientas' | split: ',' %}
    {% assign category_titles = 'Tecnología,Ropa y Moda,Deporte y Fútbol,Herramientas' | split: ',' %}
    {% for handle in category_handles %}
      {% assign collection = collections[handle] %}
      <a class="prh-category-card" href="{{ collection.url | default: '/collections/' | append: handle }}">
        {% if collection.featured_image %}
          {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 900px) 25vw, 50vw', alt: collection.title }}
        {% else %}
          <div class="prh-category-card__placeholder"></div>
        {% endif %}
        <div><strong>{{ category_titles[forloop.index0] }}</strong><span>Ver productos →</span></div>
      </a>
    {% endfor %}
  </div>
</section>
{% stylesheet %}
.prh-categories{max-width:1200px;margin:auto;padding:65px 20px 90px}.prh-categories__intro{text-align:center;margin-bottom:45px}.prh-categories__intro p{font-size:11px;letter-spacing:.16em;font-weight:700}.prh-categories h1{font-size:clamp(40px,6vw,62px);margin:8px 0 12px}.prh-categories__intro span{color:#777}.prh-categories__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.prh-category-card{text-decoration:none;color:#171717;border:1px solid #e4e4e4;border-radius:10px;overflow:hidden;background:#fff}.prh-category-card img,.prh-category-card__placeholder{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;background:#f1f1f1}.prh-category-card>div:last-child{padding:18px}.prh-category-card strong,.prh-category-card span{display:block}.prh-category-card strong{font-size:16px}.prh-category-card span{margin-top:7px;color:#777;font-size:12px}.prh-category-card:hover{transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,.08)}@media(max-width:900px){.prh-categories__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.prh-categories__grid{grid-template-columns:1fr}}
{% endstylesheet %}
{% schema %}{"name":"PRH Categorías","settings":[]}{% endschema %}
