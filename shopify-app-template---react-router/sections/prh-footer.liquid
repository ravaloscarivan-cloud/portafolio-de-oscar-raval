<footer class="prh-footer">

  <!-- =========================
       FOOTER PRINCIPAL
       ========================= -->
  <div class="prh-footer__top">

    <div class="prh-footer__container">

      <!-- MARCA -->
      <div class="prh-footer__brand">

        <a href="{{ routes.root_url }}" class="prh-footer__logo">
          <img
            src="{{ 'logo-prh.png' | asset_url }}"
            alt="PRH Store"
            loading="lazy"
          >
        </a>

        <p>
          Tu tienda online de tecnología, moda, deporte,
          herramientas y mucho más.
        </p>

        <div class="prh-footer__brand-line"></div>

        <span class="prh-footer__brand-small">
          Compra fácil, rápido y seguro.
        </span>

      </div>


      <!-- =========================
           COMPRAR
           ========================= -->
      <div class="prh-footer__column">

        <h3>
          <span class="prh-footer__title-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 7h12l1 13H5L6 7Z"/>
              <path d="M9 7a3 3 0 0 1 6 0"/>
            </svg>
          </span>
          Comprar
        </h3>

        <nav class="prh-footer__links">

          <a href="{{ routes.all_products_collection_url }}">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="4" width="6" height="6" rx="1"/>
                <rect x="14" y="4" width="6" height="6" rx="1"/>
                <rect x="4" y="14" width="6" height="6" rx="1"/>
                <rect x="14" y="14" width="6" height="6" rx="1"/>
              </svg>
            </span>
            Todos los productos
          </a>

          <a href="/collections/computadores">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="13" rx="1"/>
                <path d="M8 21h8M12 17v4"/>
              </svg>
            </span>
            Tecnología
          </a>

          <a href="/collections/ropa-y-moda">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 4l3 3 3-3 5 3-2 5-2-1v9H8v-9l-2 1-2-5 5-3Z"/>
              </svg>
            </span>
            Ropa y Moda
          </a>

          <a href="/collections/deporte">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M3 12h18"/>
                <path d="M12 3c3 3 3 15 0 18"/>
                <path d="M12 3c-3 3-3 15 0 18"/>
              </svg>
            </span>
            Deporte y Fútbol
          </a>

          <a href="/collections/herramientas">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 5a5 5 0 0 0 5 5l-8 8a2.1 2.1 0 1 1-3-3l8-8a5 5 0 0 0-2-5Z"/>
                <path d="M5 5l4 4"/>
              </svg>
            </span>
            Herramientas
          </a>

        </nav>

      </div>


      <!-- =========================
           AYUDA
           ========================= -->
      <div class="prh-footer__column">

        <h3>
          <span class="prh-footer__title-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <path d="M9.5 9a2.5 2.5 0 1 1 4.2 1.8c-1.1.8-1.7 1.2-1.7 2.7"/>
              <circle cx="12" cy="17" r=".7"/>
            </svg>
          </span>
          Ayuda
        </h3>

        <nav class="prh-footer__links">

          <a href="{{ routes.contact_url }}">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 5h16v11H8l-4 3V5Z"/>
                <path d="M8 9h8"/>
                <path d="M8 12h5"/>
              </svg>
            </span>
            Contacto
          </a>

          <a href="/pages/ofertas">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3l2.3 5.3L20 10l-4.2 4.2 1 5.8-4.8-2.7L7.2 20l1-5.8L4 10l5.7-1.7L12 3Z"/>
              </svg>
            </span>
            Ofertas
          </a>

          <a href="{{ routes.cart_url }}">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 4h2l2 12h11l2-8H6"/>
                <circle cx="9" cy="20" r="1"/>
                <circle cx="17" cy="20" r="1"/>
              </svg>
            </span>
            Carrito
          </a>

          <a href="{{ routes.search_url }}">
            <span class="prh-footer__icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5"/>
                <path d="m16 16 5 5"/>
              </svg>
            </span>
            Buscar
          </a>

        </nav>

      </div>


      <!-- =========================
           SÍGUENOS
           ========================= -->
      <div class="prh-footer__column">

        <h3>
          <span class="prh-footer__title-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16v11H8l-4 3V5Z"/>
            </svg>
          </span>
          Síguenos
        </h3>

        <nav class="prh-footer__links">

          <!-- WHATSAPP -->
          <a
            href="https://whatsapp.com/channel/0029Vb8N1d37dmeRtNTEgT14"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="prh-footer__social-icon prh-footer__whatsapp">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Z"/>
                <path d="M8.5 8.5c.3-.5.6-.5 1-.5h.5c.2 0 .4.2.5.5l.7 1.7c.1.3.1.5-.1.7l-.6.7c.8 1.5 1.8 2.3 3.4 3.1l.7-.7c.2-.2.4-.2.7-.1l1.6.8c.3.1.4.3.4.6v.5c0 .4-.1.7-.5 1-2.2 1.1-7.2-2.1-8.4-5.9-.2-.8-.2-1.5.1-2.4Z"/>
              </svg>
            </span>
            WhatsApp
          </a>


          <!-- INSTAGRAM -->
          <a
            href="https://ig.me/j/ta9fg9KnOhOrKjw5/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="prh-footer__social-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1"/>
              </svg>
            </span>
            Instagram
          </a>


          <!-- TIKTOK -->
          <a
            href="https://www.tiktok.com/@prhstore_?is_from_webapp=1&sender_device=pc"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="prh-footer__social-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 4c.5 2.4 1.8 3.8 4 4v3.2c-1.5-.1-2.8-.6-4-1.5v6.1a5.2 5.2 0 1 1-5.2-5.2c.4 0 .8 0 1.2.1v3.3a2.1 2.1 0 1 0 .8 1.8V4H15Z"/>
              </svg>
            </span>
            TikTok
          </a>

        </nav>

      </div>

    </div>
  </div>


  <!-- =========================
       CONFIANZA
       ========================= -->
  <div class="prh-footer__trust">

    <div class="prh-footer__container prh-footer__trust-grid">

      <!-- COMPRA SEGURA -->
      <div class="prh-footer__trust-item">

        <div class="prh-footer__trust-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"/>
            <path d="m8 12 2.5 2.5L16 9"/>
          </svg>
        </div>

        <div>
          <strong>Compra segura</strong>
          <span>Proceso protegido</span>
        </div>

      </div>


      <!-- ENVÍOS -->
      <div class="prh-footer__trust-item">

        <div class="prh-footer__trust-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6h11v11H3z"/>
            <path d="M14 10h4l3 3v4h-7z"/>
            <circle cx="7" cy="19" r="2"/>
            <circle cx="18" cy="19" r="2"/>
          </svg>
        </div>

        <div>
          <strong>Envíos nacionales</strong>
          <span>Despachos a Colombia</span>
        </div>

      </div>


      <!-- ATENCIÓN -->
      <div class="prh-footer__trust-item">

        <div class="prh-footer__trust-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 12a8 8 0 0 1-8 8H5l-1 1v-5a8 8 0 1 1 16-4Z"/>
            <path d="M8 9h8"/>
            <path d="M8 12h6"/>
            <path d="M8 15h4"/>
          </svg>
        </div>

        <div>
          <strong>Atención personalizada</strong>
          <span>Estamos para ayudarte</span>
        </div>

      </div>

    </div>

  </div>


  <!-- =========================
       COPYRIGHT
       ========================= -->
  <div class="prh-footer__bottom">

    <div class="prh-footer__container">

      <span>
        © {{ 'now' | date: '%Y' }} {{ shop.name }}.
        Todos los derechos reservados.
      </span>

      <a href="{{ routes.root_url }}">
        PRH Store
      </a>

    </div>

  </div>

</footer>


{% stylesheet %}

  /* ========================================
     BASE
     ======================================== */

  .prh-footer {
    --prh-bg: #292929;
    --prh-bg-bottom: #252525;
    --prh-border: rgba(255, 255, 255, 0.12);
    --prh-text: #ffffff;
    --prh-muted: #bcbcbc;

    background: var(--prh-bg);
    color: var(--prh-text);
    width: 100%;
    overflow: hidden;
  }


  .prh-footer__container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* ========================================
     PARTE SUPERIOR
     ======================================== */

  .prh-footer__top {
    padding: 58px 0 52px;
  }


  .prh-footer__top > .prh-footer__container {
    display: grid;
    grid-template-columns: 1.55fr 1fr 1fr 1fr;
    gap: 55px;
    align-items: start;
  }


  /* ========================================
     LOGO
     ======================================== */

  .prh-footer__brand {
    min-width: 0;
  }


  .prh-footer__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    opacity: 1 !important;
    margin-bottom: 19px;
  }


  .prh-footer__logo img {
    display: block;
    width: 250px;
    max-width: 100%;
    height: auto;
    max-height: 90px;
    object-fit: contain;
    object-position: left center;
  }


  .prh-footer__brand p {
    max-width: 350px;
    margin: 0;
    color: var(--prh-muted);
    font-size: 14px;
    line-height: 1.7;
  }


  .prh-footer__brand-line {
    width: 42px;
    height: 2px;
    margin: 21px 0 13px;
    background: #ffffff;
    opacity: .65;
  }


  .prh-footer__brand-small {
    color: #999999;
    font-size: 12px;
  }


  /* ========================================
     COLUMNAS
     ======================================== */

  .prh-footer__column {
    min-width: 0;
  }


  .prh-footer__column h3 {
    display: flex;
    align-items: center;
    gap: 10px;

    margin: 2px 0 22px;

    color: #ffffff;

    font-size: 14px;
    font-weight: 800;

    line-height: 1.2;

    text-transform: uppercase;

    letter-spacing: .04em;
  }


  /* ========================================
     ICONOS DE TÍTULOS
     ======================================== */

  .prh-footer__title-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 29px;
    height: 29px;

    flex: 0 0 29px;

    border: 1px solid rgba(255,255,255,.2);
    border-radius: 7px;

    color: #ffffff;
  }


  .prh-footer__title-icon svg {
    width: 16px;
    height: 16px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* ========================================
     LINKS
     ======================================== */

  .prh-footer__links {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }


  .prh-footer__links a {
    display: flex;
    align-items: center;

    width: fit-content;

    gap: 10px;

    color: #c5c5c5;

    font-size: 13px;

    line-height: 1.4;

    text-decoration: none;

    transition:
      color .2s ease,
      transform .2s ease;
  }


  .prh-footer__links a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }


  /* ========================================
     ICONOS DE LINKS
     ======================================== */

  .prh-footer__icon,
  .prh-footer__social-icon {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    flex: 0 0 22px;

    color: #a9a9a9;
  }


  .prh-footer__icon svg,
  .prh-footer__social-icon svg {
    width: 17px;
    height: 17px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  /* WHATSAPP */

  .prh-footer__whatsapp {
    color: #8bd3a4;
  }


  /* ========================================
     BLOQUE DE CONFIANZA
     ======================================== */

  .prh-footer__trust {
    border-top: 1px solid var(--prh-border);
    border-bottom: 1px solid var(--prh-border);
  }


  .prh-footer__trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }


  .prh-footer__trust-item {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 14px;

    min-height: 102px;

    padding: 20px 25px;
  }


  .prh-footer__trust-item + .prh-footer__trust-item {
    border-left: 1px solid var(--prh-border);
  }


  .prh-footer__trust-icon {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    flex: 0 0 40px;

    border: 1px solid rgba(255,255,255,.18);

    border-radius: 50%;

    color: #d2d2d2;
  }


  .prh-footer__trust-icon svg {
    width: 19px;
    height: 19px;

    fill: none;
    stroke: currentColor;

    stroke-width: 1.6;

    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .prh-footer__trust-item strong {
    display: block;

    margin-bottom: 5px;

    color: #ffffff;

    font-size: 12px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .04em;
  }


  .prh-footer__trust-item span {
    display: block;

    color: #999999;

    font-size: 11px;
  }


  /* ========================================
     COPYRIGHT
     ======================================== */

  .prh-footer__bottom {
    background: var(--prh-bg-bottom);

    padding: 17px 0;
  }


  .prh-footer__bottom .prh-footer__container {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }


  .prh-footer__bottom span,
  .prh-footer__bottom a {
    color: #888888;

    font-size: 11px;

    text-decoration: none;
  }


  .prh-footer__bottom a:hover {
    color: #ffffff;
  }


  /* ========================================
     TABLET
     ======================================== */

  @media screen and (max-width: 989px) {

    .prh-footer__top > .prh-footer__container {
      grid-template-columns: repeat(2, 1fr);
      gap: 45px 35px;
    }


    .prh-footer__brand {
      grid-column: 1 / -1;
    }

  }


  /* ========================================
     MÓVIL
     ======================================== */

  @media screen and (max-width: 749px) {

    .prh-footer__container {
      width: calc(100% - 32px);
    }


    .prh-footer__top {
      padding: 45px 0 40px;
    }


    .prh-footer__top > .prh-footer__container {
      grid-template-columns: 1fr;
      gap: 35px;
    }


    .prh-footer__brand {
      grid-column: auto;
    }


    .prh-footer__logo img {
      width: 210px;
      max-height: 80px;
    }


    .prh-footer__brand p {
      max-width: 100%;
    }


    .prh-footer__column h3 {
      margin-bottom: 17px;
    }


    .prh-footer__links {
      gap: 12px;
    }


    .prh-footer__trust-grid {
      grid-template-columns: 1fr;
    }


    .prh-footer__trust-item {
      justify-content: flex-start;

      min-height: auto;

      padding: 20px 0;
    }


    .prh-footer__trust-item + .prh-footer__trust-item {
      border-left: 0;

      border-top: 1px solid var(--prh-border);
    }


    .prh-footer__bottom .prh-footer__container {
      flex-direction: column;

      justify-content: center;

      gap: 7px;

      text-align: center;
    }

  }

{% endstylesheet %}


{% schema %}
{
  "name": "PRH Footer",
  "settings": [],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}