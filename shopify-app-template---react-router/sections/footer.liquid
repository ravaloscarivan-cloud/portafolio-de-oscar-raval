          <a href="{{ routes.search_url }}">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5"/>
                <path d="m16 16 5 5"/>
              </svg>
            </span>
            Buscar
          </a>

        </nav>

      </div>


      <!-- SÍGUENOS -->
      <div class="prh-footer__column">

        <h3 class="prh-footer__title">
          <span class="prh-footer__title-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 5h16v11H8l-4 3V5Z"/>
            </svg>
          </span>
          SÍGUENOS
        </h3>

        <nav class="prh-footer__links">

          <a
            href="https://whatsapp.com/channel/0029Vb8N1d37dmeRtNTEgT14"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="prh-footer__social-icon prh-footer__social-icon--whatsapp">
              <svg viewBox="0 0 24 24" aria-hidden="true">
