              </svg>
            </span>
            WhatsApp
          </a>

          <a
            href="https://ig.me/j/ta9fg9KnOhOrKjw5/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="prh-footer__social-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1"/>
              </svg>
            </span>
            Instagram
          </a>

          <a
            href="https://www.tiktok.com/@prhstore_?is_from_webapp=1&sender_device=pc"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="prh-footer__social-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 4c.5 2.4 1.8 3.8 4 4v3.2c-1.5-.1-2.8-.6-4-1.5v6.1a5.2 5.2 0 1 1-5.2-5.2c.4 0 .8 0 1.2.1v3.3a2.1 2.1 0 1 0 .8 1.8V4H15Z"/>
              </svg>
            </span>
            TikTok
          </a>

        </nav>

      </div>

    </div>
  </div>


  <!-- CONFIANZA -->
  <div class="prh-footer__trust">

    <div class="prh-footer__container prh-footer__trust-grid">

      <div class="prh-footer__trust-item">

        <div class="prh-footer__trust-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3 20 6v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-3Z"/>
            <path d="m8 12 2.5 2.5L16 9"/>
          </svg>
        </div>

        <div>
          <strong>COMPRA SEGURA</strong>
          <span>Proceso protegido</span>
        </div>

      </div>


      <div class="prh-footer__trust-item">

        <div class="prh-footer__trust-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6h11v11H3z"/>
            <path d="M14 10h4l3 3v4h-7z"/>
            <circle cx="7" cy="19" r="2"/>
            <circle cx="18" cy="19" r="2"/>
          </svg>
        </div>

        <div>
          <strong>ENVÍOS NACIONALES</strong>
          <span>Despachos a Colombia</span>
        </div>

      </div>


      <div class="prh-footer__trust-item">

        <div class="prh-footer__trust-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 12a8 8 0 0 1-8 8H5l-1 1v-5a8 8 0 1 1 16-4Z"/>
            <path d="M8 12h8M8 9h5M8 15h6"/>
          </svg>
        </div>

        <div>
          <strong>ATENCIÓN PERSONALIZADA</strong>
          <span>Estamos para ayudarte</span>
        </div>

      </div>

    </div>

  </div>


  <!-- COPYRIGHT -->
  <div class="prh-footer__bottom">

    <div class="prh-footer__container prh-footer__bottom-inner">

      <p>
        © {{ 'now' | date: '%Y' }} PRH Store. Todos los derechos reservados.
      </p>

      <a href="{{ routes.root_url }}">
        PRH Store
      </a>

    </div>

  </div>

</footer>


{% stylesheet %}

  .prh-footer {
    --prh-footer-bg: #292929;
    --prh-footer-border: rgba(255, 255, 255, 0.12);
    --prh-footer-text: #f5f5f5;
    --prh-footer-muted: #b9b9b9;
    --prh-footer-accent: #1b6b5f;

    background: var(--prh-footer-bg);
    color: var(--prh-footer-text);
    width: 100%;
    overflow: hidden;
  }


  .prh-footer__container {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }


  /* =========================
     PARTE PRINCIPAL
     ========================= */

  .prh-footer__main {
    padding: 58px 0 52px;
  }


  .prh-footer__container:not(.prh-footer__trust-grid) {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 55px;
  }


  .prh-footer__brand {
    min-width: 0;
  }


  .prh-footer__logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-bottom: 20px;
  }


  .prh-footer__logo {
    display: block;
    width: 220px;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }


  .prh-footer__description {
    max-width: 330px;
    margin: 0;
    color: var(--prh-footer-muted);
    font-size: 14px;
    line-height: 1.7;
  }


  .prh-footer__brand-line {
    width: 42px;
    height: 2px;
    margin: 22px 0 14px;
    background: #ffffff;
    opacity: 0.7;
  }


  .prh-footer__small {
    margin: 0;
    color: #999;
    font-size: 13px;
  }


  /* =========================
     COLUMNAS
     ========================= */

  .prh-footer__column {
    min-width: 0;
  }


  .prh-footer__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 3px 0 24px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.3px;
  }


  .prh-footer__title-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 27px;
    height: 27px;
    flex: 0 0 27px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 7px;
  }


  .prh-footer__title-icon svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .prh-footer__links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }


  .prh-footer__links a {
    display: flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    color: #c9c9c9;
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }


  .prh-footer__links a:hover {
    color: #ffffff;
    transform: translateX(3px);
  }


  .prh-footer__link-icon,
  .prh-footer__social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    color: #aaaaaa;
  }


  .prh-footer__link-icon svg,
  .prh-footer__social-icon svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .prh-footer__social-icon--whatsapp {
    color: #9bd8b1;
  }


  /* =========================
     CONFIANZA
     ========================= */

  .prh-footer__trust {
    border-top: 1px solid var(--prh-footer-border);
    border-bottom: 1px solid var(--prh-footer-border);
  }


  .prh-footer__trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }


  .prh-footer__trust-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 100px;
    padding: 20px 30px;
  }


  .prh-footer__trust-item + .prh-footer__trust-item {
    border-left: 1px solid var(--prh-footer-border);
  }


  .prh-footer__trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
  }


  .prh-footer__trust-icon svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: #d0d0d0;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .prh-footer__trust-item strong {
    display: block;
    margin-bottom: 6px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2px;
  }


  .prh-footer__trust-item span {
    display: block;
    color: #999999;
    font-size: 12px;
  }


  /* =========================
     COPYRIGHT
     ========================= */

  .prh-footer__bottom {
    background: #262626;
  }


  .prh-footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    gap: 20px;
  }


  .prh-footer__bottom p,
  .prh-footer__bottom a {
    margin: 0;
    color: #888888;
    font-size: 12px;
    text-decoration: none;
  }


  .prh-footer__bottom a:hover {
    color: #ffffff;
  }


  /* =========================
     TABLET
     ========================= */

  @media screen and (max-width: 989px) {

    .prh-footer__container:not(.prh-footer__trust-grid) {
      grid-template-columns: repeat(2, 1fr);
      gap: 45px 35px;
    }

    .prh-footer__brand {
      grid-column: 1 / -1;
    }

    .prh-footer__trust-item {
      padding: 18px;
    }

  }


  /* =========================
     MÓVIL
     ========================= */

  @media screen and (max-width: 749px) {

    .prh-footer__container {
      width: min(100% - 32px, 500px);
    }


    .prh-footer__main {
      padding: 45px 0 40px;
    }


    .prh-footer__container:not(.prh-footer__trust-grid) {
      display: grid;
      grid-template-columns: 1fr;
      gap: 35px;
    }


    .prh-footer__brand {
      grid-column: auto;
    }


    .prh-footer__logo {
      width: 200px;
    }


    .prh-footer__description {
      max-width: 100%;
    }


    .prh-footer__title {
      margin-bottom: 18px;
    }


    .prh-footer__links {
      gap: 12px;
    }


    .prh-footer__trust-grid {
      grid-template-columns: 1fr;
    }


    .prh-footer__trust-item {
      justify-content: flex-start;
      min-height: auto;
      padding: 20px 0;
    }


    .prh-footer__trust-item + .prh-footer__trust-item {
      border-left: 0;
      border-top: 1px solid var(--prh-footer-border);
    }


    .prh-footer__bottom-inner {
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      padding: 15px 0;
      text-align: center;
    }

  }

{% endstylesheet %}