<footer class="prh-footer">

  <div class="prh-footer__main">
    <div class="prh-footer__container">

      <!-- MARCA -->
      <div class="prh-footer__brand">

        <a href="{{ routes.root_url }}" class="prh-footer__logo-link">
          <img
            src="{{ 'logo-prh.png' | asset_url }}"
            alt="PRH Store"
            class="prh-footer__logo"
            loading="lazy"
          >
        </a>

        <p class="prh-footer__description">
          Tu tienda online de tecnología, moda, deporte,
          herramientas y mucho más.
        </p>

        <div class="prh-footer__brand-line"></div>

        <p class="prh-footer__small">
          Compra fácil, rápido y seguro.
        </p>

      </div>


      <!-- COMPRAR -->
      <div class="prh-footer__column">

        <h3 class="prh-footer__title">
          <span class="prh-footer__title-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 7h12l1 13H5L6 7Z"/>
              <path d="M9 7a3 3 0 0 1 6 0"/>
            </svg>
          </span>
          COMPRAR
        </h3>

        <nav class="prh-footer__links">

          <a href="{{ routes.all_products_collection_url }}">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="4" width="6" height="6" rx="1"/>
                <rect x="14" y="4" width="6" height="6" rx="1"/>
                <rect x="4" y="14" width="6" height="6" rx="1"/>
                <rect x="14" y="14" width="6" height="6" rx="1"/>
              </svg>
            </span>
            Todos los productos
          </a>

          <a href="/collections/computadores">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="13" rx="1"/>
                <path d="M8 21h8M12 17v4"/>
              </svg>
            </span>
            Tecnología
          </a>

          <a href="/collections/ropa-y-moda">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 4l3 3 3-3 5 3-2 5-2-1v9H8v-9l-2 1-2-5 5-3Z"/>
              </svg>
            </span>
            Ropa y Moda
          </a>

          <a href="/collections/deporte">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>
              </svg>
            </span>
            Deporte y Fútbol
          </a>

          <a href="/collections/herramientas">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 5a5 5 0 0 0 5 5l-8 8a2.1 2.1 0 1 1-3-3l8-8a5 5 0 0 0-2-5Z"/>
                <path d="M5 5l4 4"/>
              </svg>
            </span>
            Herramientas
          </a>

        </nav>

      </div>


      <!-- AYUDA -->
      <div class="prh-footer__column">

        <h3 class="prh-footer__title">
          <span class="prh-footer__title-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/>
              <path d="M9.5 9a2.5 2.5 0 1 1 4.2 1.8c-1.1.8-1.7 1.2-1.7 2.7"/>
              <circle cx="12" cy="17" r=".7"/>
            </svg>
          </span>
          AYUDA
        </h3>

        <nav class="prh-footer__links">

          <a href="{{ routes.contact_url }}">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 5h16v11H8l-4 3V5Z"/>
                <path d="M8 9h8M8 12h5"/>
              </svg>
            </span>
            Contacto
          </a>

          <a href="/pages/ofertas">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3l2.3 5.3L20 10l-4.2 4.2 1 5.8-4.8-2.7L7.2 20l1-5.8L4 10l5.7-1.7L12 3Z"/>
              </svg>
            </span>
            Ofertas
          </a>

          <a href="{{ routes.cart_url }}">
            <span class="prh-footer__link-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 4h2l2 12h11l2-8H6"/>
                <circle cx="9" cy="20" r="1"/>
                <circle cx="17" cy="20" r="1"/>
              </svg>
            </span>
            Carrito
