# Copia este archivo como .env.local y completa los valores. .env.local no se sube al repositorio.

# Clave para abrir la sección Resultados. En local, si no se define, la clave es "clave-local".
# La clave de producción se configura en Vercel (Settings → Environment Variables), no aquí.
RESULTS_ACCESS_KEY=

# Correos que entran a la sección Administrador (ver, editar, agregar y borrar respuestas), separados
# por comas. Cualquier otro correo no entra. Los de producción se configuran en Vercel.
ADMIN_EMAILS=
# Con "si", Administrador pide además un código que Supabase envía al correo (solo en producción).
# ADMIN_CODIGO_CORREO=si

# Supabase (producción). Se configuran en Vercel (Settings → Environment Variables). Aquí solo hacen
# falta para correr scripts/migrar-blob-a-supabase.mjs o probar contra Supabase desde tu equipo.
# Supabase → Project Settings → API: Project URL y la clave service_role (secreta: nunca en el navegador).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=hv-sanithelp

# Copia independiente en Firebase Realtime Database. Se configura también como variables privadas
# del servidor en Vercel. La clave privada viene del JSON de una cuenta de servicio de Firebase.
# FIREBASE_DATABASE_URL=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=PEM privado con saltos \n; también admite base64:<PEM codificado en base64>.
# FIREBASE_PRIVATE_KEY=

# Solo para scripts/migrar-blob-a-supabase.mjs (copiar los datos que quedaron en Vercel Blob).
# BLOB_READ_WRITE_TOKEN=
