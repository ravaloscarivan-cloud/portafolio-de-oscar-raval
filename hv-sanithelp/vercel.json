{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/migrar-blob", "schedule": "0 11 * * *" }],
  "rewrites": [{ "source": "/api/admin/:ruta*", "destination": "/api/admin/entrada?__ruta=:ruta*" }],
  "functions": {
    "api/migrar-blob.js": { "maxDuration": 300 }
  }
}
